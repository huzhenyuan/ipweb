# Copy to .env, then replace the IP, email, WordPress URL, and passwords.
PUBLIC_IP=203.0.113.10
CERTBOT_EMAIL=admin@example.com
WP_SITE_URL=https://203.0.113.10
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

# DaoCloud image mirror. Check availability with "podman compose pull".
NGINX_IMAGE=m.daocloud.io/docker.io/library/nginx:1.28-alpine
WORDPRESS_IMAGE=m.daocloud.io/docker.io/library/wordpress:php8.3-apache
MARIADB_IMAGE=m.daocloud.io/docker.io/library/mariadb:11.4
CERTBOT_IMAGE=m.daocloud.io/docker.io/certbot/certbot:v5.4.0

# DaoCloud's public repository list does not include certbot/certbot, although
# the tag above was pullable when this example was checked. If it disappears,
# use your own registry copy of certbot/certbot:v5.4.0 or newer.
